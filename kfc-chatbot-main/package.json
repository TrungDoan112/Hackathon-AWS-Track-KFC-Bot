{
  "name": "kfc-conversational-ordering-demo",
  "version": "1.0.0",
  "private": true,
  "description": "Local KFC Vietnam conversational ordering demo with OpenAI Agents SDK",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/server.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch src/server.js",
    "db:setup": "node --disable-warning=ExperimentalWarning scripts/setup-db.js",
    "reset:demo": "node --disable-warning=ExperimentalWarning scripts/reset-demo.js",
    "zalo:bot:info": "node scripts/zalo-webhook.js me",
    "zalo:webhook:set": "node scripts/zalo-webhook.js set",
    "zalo:webhook:info": "node scripts/zalo-webhook.js info",
    "test": "node --disable-warning=ExperimentalWarning --test"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@openai/agents": "latest",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "zod": "^4.3.6"
  }
}
